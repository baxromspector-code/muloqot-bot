# @BotFather dan olingan token
BOT_TOKEN=123456789:AA...

# PostgreSQL: postgresql://foydalanuvchi:parol@host:5432/baza
DATABASE_URL=postgresql://muloqot:muloqot@localhost:5432/muloqot

# Arizalar, murojaatlar, ko'ngillilar tushadigan guruh (Kengash / Bosh kotib). Guruh ID manfiy: -100...
ADMIN_CHAT_ID=-1001234567890
# Shikoyatlar uchun alohida guruh (Intizom hay'ati). Bo'sh qoldirilsa ADMIN_CHAT_ID ishlatiladi.
COMPLAINT_CHAT_ID=
# Admin buyruqlari (/addevent, /check ...) ruxsat etilganlar, vergul bilan
ADMIN_IDS=111111111,222222222

TELEGRAM_URL=https://t.me/kiut_muloqot
INSTAGRAM_URL=https://instagram.com/kiut.muloqot

# Ixtiyoriy: bot qayta ishga tushganda boshlangan jarayonlar yo'qolmasligi uchun
REDIS_URL=

# ---------------- Maxfiy admin sayti (python -m admin_site) ----------------
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → Web application
#   Authorized redirect URI:  https://SAYT-MANZILI/auth/callback   (mahalliyda: http://127.0.0.1:8080/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Saytga kira oladigan Google akkauntlar (vergul bilan). Ro'yxatdan o'chirilgan akkaunt darhol chiqarib yuboriladi.
ADMIN_GOOGLE_EMAILS=admin1@gmail.com,admin2@gmail.com
# 1 — ro'yxat cheklovisiz: istalgan Google akkaunt kiradi (faqat vaqtincha!)
ADMIN_ALLOW_ANY_GOOGLE=0
# Sayt manzili (domen bo'lsa). Bo'sh bo'lsa so'rov manzilidan olinadi.
ADMIN_BASE_URL=
# HTTPS orqali ishlaganda 1
ADMIN_HTTPS=0
# Cookie imzolash kaliti (uzun tasodifiy satr). Bo'sh bo'lsa bot tokenidan hosil qilinadi.
ADMIN_SECRET_KEY=
# Dizayn: diplomat | oq | aurora | skeuo (Qaymoq) | glass
ADMIN_THEME=skeuo
# Dizaynni almashtirish doirachalari: Qaymoq, Glass va Diplomat (0 — yashirin, faqat ADMIN_THEME ishlatiladi)
ADMIN_THEME_SWITCH=0
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080
# Faqat sinov uchun (Google sozlanmaguncha, faqat 127.0.0.1 dan): 1
ADMIN_DEV_LOGIN=0
# Admin panelga botdagi /panel orqali kira oladigan Telegram ID'lar (vergul bilan). Bo'sh — ADMIN_IDS ishlatiladi.
PANEL_ADMIN_IDS=
# Sayt manzili (bot /panel havolasini shundan quradi), masalan https://muloqotclub.uz
SITE_URL=
# Ochiq saytning boshlang'ich ma'lumotlari (keyin admin paneldagi «Sayt ma'lumotlari»dan o'zgartiriladi)
SITE_PHONE=+998 78 129 40 40
SITE_ADDRESS=Toshkent sh., Yakkasaroy tumani, Shota Rustaveli ko'chasi, 156
SITE_BOT_URL=https://t.me/KIUT_muloqotbot
